# FOMAXO — always use secure https://
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# link preview picture: Instagram / Facebook show a square, so their link reader gets the square version
# (WhatsApp and everyone else get the wide 1200x630 one at the same address)
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Instagram|meta-externalagent|Facebot) [NC]
RewriteRule ^assets/img/link-preview\.jpg$ assets/img/link-preview-square.jpg [L]
<FilesMatch "^link-preview(-square)?\.jpg$">
  <IfModule mod_headers.c>
    Header set Vary "User-Agent"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</FilesMatch>

# uploads from the admin (shop videos, cover and product photos) are kept above public_html, because each GitHub update
# removes files that are not on GitHub; their addresses stay the same and media.php sends them
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/(vid/[a-z0-9-]+\.(?:mp4|mov|webm)|img/up/[a-z0-9-]+\.webp)$ media.php?f=$1 [L]
# customer review photos: the web server sends its own copy in media/r; one with no copy yet (new, or removed by a GitHub update)
# goes to reviews.php once, which makes it. Before, every review photo held a PHP process while it downloaded.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^media/r/([a-f0-9]{16}-\d\.jpg)$ reviews.php?photo=$1 [L]

# the home page as an Arabic link (fomaxo.com/?lang=ar): same page, Arabic words in the WhatsApp / Instagram preview
RewriteCond %{QUERY_STRING} (^|&)lang=ar(&|$)
RewriteRule ^(index\.html)?$ home.php [L,QSA]

# product addresses for Google: fomaxo.com/fomaxo-gold → product.php; fomaxo.com/sitemap.xml → sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]
# product list for free Google Shopping listings (Merchant Center): English and Arabic
RewriteRule ^google-shopping\.xml$ google-feed.php [L]
RewriteRule ^google-shopping-ar\.xml$ google-feed.php?lang=ar [L]
RewriteRule ^google-reviews\.xml$ google-reviews.php [L]
# the Returns page at its own address (Google Merchant Center links to it)
RewriteRule ^returns/?$ returns.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^fomaxo-([A-Za-z0-9-]+)/$ /fomaxo-$1 [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^fomaxo-([A-Za-z0-9-]+)$ product.php?p=$1 [L,QSA]

# keep the Stripe, Ziina and database key files private
<FilesMatch "^(?i:stripe|ziina|whatsapp|fomaxo-db)-config.*\.php$">
  Require all denied
</FilesMatch>

# keep the shop's own working files private: setup notes (.md, .txt except robots.txt), old homepage copies
# (index-2.html, index-3.html), the product data file, example settings, the -lib.php helpers and hidden dot-files.
# The site and admin read these on the server, never through the browser, so nothing visible changes.
<FilesMatch "(?i)(^\.|\.(md|bak|old|orig|sql|log|zip|sh|ini|json)$|^(?!robots\.txt$).*\.txt$|^index-\d+\.html?$|\.example\.php$|-lib\.php$)">
  Require all denied
</FilesMatch>

# faster loading: cache photos for 30 days
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml font/otf
</IfModule>

# shop videos (admin → Products → Videos): each upload has its own new name, so phones can keep them for 30 days
AddType video/mp4 .mp4
AddType video/quicktime .mov
AddType video/webm .webm
AddType application/wasm .wasm
<IfModule mod_expires.c>
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/quicktime "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>

# price font (Charles Wright Singapore)
AddType font/woff2 .woff2
AddType font/otf .otf
<IfModule mod_expires.c>
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# Hostinger CDN and browsers: the shop page itself is always checked for a newer copy (a GitHub update shows straight away,
# unchanged pages answer "not modified" in a few bytes); the Arabic word list is kept 7 days (its ?v= number in index.html is
# bumped whenever it changes). Checkout, payments, admin and the shop's data pages send their own "never keep" header.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^i18n-ar\.js$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
